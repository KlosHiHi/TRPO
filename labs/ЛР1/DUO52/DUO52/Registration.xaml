<Window x:Class="DUO52.Registration"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:DUO52"
        mc:Ignorable="d"
        Title="Registration" Height="450" Width="800">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
            <RowDefinition/>
        </Grid.RowDefinitions>
        <TextBlock Grid.Row="0" Text="Логин" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBox x:Name="LoginTextBox" Grid.Row="1" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <TextBlock Grid.Row="2" Text="Пароль" VerticalAlignment="Bottom" HorizontalAlignment="Center"/>
        <TextBox x:Name="PasswordTextBox" VerticalAlignment="Top" HorizontalAlignment="Center"/>
        <Button x:Name="ConfirmRegistration" Click="ConfirmRegistration_Click" Grid.Row="4" Content="Зарегистрироваться"/> 
    </Grid>
</Window>
